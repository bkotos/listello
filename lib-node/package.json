{
  "name": "@bkotos/listello",
  "version": "0.0.1",
  "description": "Listello Node SDK (Go core via js/wasm)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:wasm": "make -C ../lib-go build-js-wasm",
    "build:all": "npm run build:wasm && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
